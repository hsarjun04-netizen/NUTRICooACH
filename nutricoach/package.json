{
  "name": "nutricoach",
  "version": "1.0.0",
  "description": "NutriCoach - AI-powered nutrition coaching application",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "preview": "npm --workspace=frontend run preview",
    "start": "npm run build && python backend/wsgi.py",
    "start:unified": "python start.py",
    "setup": "npm install && npm run build && python backend/init_db.py && python backend/seed_recipes.py",
    "db:init": "python backend/init_db.py",
    "db:seed": "python backend/seed_recipes.py",
    "backend": "python backend/wsgi.py",
    "clean": "rimraf frontend/dist frontend/node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  }
}
